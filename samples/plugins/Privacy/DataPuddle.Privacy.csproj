<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample plugin. Build it, then copy bin/<config>/net8.0/DataPuddle.Privacy.dll next to DataPuddle. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DataPuddle.Privacy</AssemblyName>
    <RootNamespace>DataPuddle.Privacy</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: do not copy DataPuddle.dll beside the plugin; the running program supplies it. -->
    <ProjectReference Include="..\..\..\DataPuddle.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
