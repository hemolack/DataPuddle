{
  "SQLSERVER_CONNECTION": "Server=localhost;Database=YourDatabase;Integrated Security=true;TrustServerCertificate=true",
  "WriteDelta": false,
  "Tables": [
    "dbo.visit",
    "dbo.payment"
  ],
  "TableFilters": {
    "dbo.visit": "IsInactive = 0 and ClientId = 1486",
    "dbo.payment": "ClientId = 1486"
  },
  "Pipeline": {
    "File": "samples/sample_pipeline.json",
    "Summary": "runs/acme/summary.json",

    "OnSuccess": {
      "Webhook": {
        "Url": "https://hooks.example.com/puddle/success",
        "Method": "POST",
        "Headers": {
          "Authorization": "Bearer REPLACE_ME"
        },
        "TimeoutSeconds": 30
      }
    },

    "OnError": {
      "Webhook": {
        "Url": "https://hooks.example.com/puddle/failed"
      },
      "Run": {
        "Command": "notify-oncall",
        "Arguments": [ "--status", "${status}", "--summary", "${summary}" ],
        "WorkingDirectory": "/opt/tools",
        "TimeoutSeconds": 300
      }
    }
  }
}
